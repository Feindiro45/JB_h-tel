# Variables du Docker Compose (infra/docker-compose.yml). Copier en `.env` à la racine et
# remplacer les valeurs « change-me ». Aucun secret réel ne doit être versionné.
#
# Les applications ont leurs propres fichiers d'exemple :
#   backend/.env.example   (Laravel : base, URL du frontend, Sanctum…)
#   frontend/.env.example  (Vite : URL de l'API, fuseau)

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jb_hotel
MYSQL_USER=jb_hotel
MYSQL_PASSWORD=change-me
# Port exposé sur le poste : 3307 pour ne pas entrer en conflit avec un MySQL/MariaDB local (XAMPP).
MYSQL_PORT=3307
