# JB Hôtel — modèle d'environnement React (Vite) pour le développement local.
# À copier en frontend/.env.local (chargé en mode dev comme en mode build).
#
# VITE_API_URL = racine publique de Laravel, sans « /api » (voir le modèle de production).
# Garder une origine cohérente avec SANCTUM_STATEFUL_DOMAINS : « localhost » partout,
# jamais un mélange de localhost et de 127.0.0.1 (deux origines distinctes pour le navigateur).

VITE_API_URL=http://localhost:8000
VITE_TIMEZONE=Africa/Bangui
