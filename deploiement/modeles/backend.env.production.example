# JB Hôtel — modèle d'environnement Laravel pour la production (deux sous-domaines).
# À copier en « .env » À LA RACINE DU PROJET LARAVEL sur le serveur, puis à compléter.
# Ce fichier ne contient AUCUN secret : il n'est jamais versionné avec des valeurs réelles.
#
# Architecture visée (voir docs/deployment/03_DEPLOIEMENT_PRODUCTION.md) :
#   https://app.jb-hotel.com -> contenu de deploiement/frontend
#   https://api.jb-hotel.com -> dossier « public » de ce projet Laravel

APP_NAME="JB Hôtel"
APP_ENV=production
# Générer sur le serveur : php artisan key:generate --force
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.jb-hotel.com
APP_TIMEZONE=Africa/Bangui
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Origines autorisées par CORS (config/cors.php lit cette variable, plusieurs valeurs séparées
# par des virgules). Aucune autre origine ne doit figurer ici en production.
FRONTEND_URL=https://app.jb-hotel.com
# Adresse des écrans du personnel, utilisée dans les e-mails (lien « choisir son mot de passe »).
APP_FRONTEND_URL=https://app.jb-hotel.com
# Domaines qui reçoivent une session Sanctum (mode SPA) : le frontend, sans schéma.
SANCTUM_STATEFUL_DOMAINS=app.jb-hotel.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
# MySQL 8+ InnoDB utf8mb4. Chez un hébergeur mutualisé, DB_HOST est souvent une IP, pas localhost.
DB_HOST=A_REMPLACER
DB_PORT=3306
DB_DATABASE=A_REMPLACER
DB_USERNAME=A_REMPLACER
DB_PASSWORD='A_REMPLACER'

# ---------------------------------------------------------------------------------------------
# Session partagée entre app.jb-hotel.com et api.jb-hotel.com — POINT CRITIQUE.
# Le frontend lit le cookie XSRF-TOKEN en JavaScript puis le renvoie dans l'en-tête X-XSRF-TOKEN.
# Avec SESSION_DOMAIN=null, ce cookie reste privé à api.jb-hotel.com : le frontend ne peut pas le
# lire et toutes les écritures échouent en 419. Le point initial autorise tous les sous-domaines.
# ---------------------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=jb_hotel_session
SESSION_DOMAIN=.jb-hotel.com
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
# « lax » suffit : les deux sous-domaines partagent le domaine jb-hotel.com (même site).
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# E-mails clients et personnel (D-039, D-054). Le mot de passe SMTP ne quitte jamais le serveur.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=A_REMPLACER
MAIL_PORT=465
MAIL_USERNAME=A_REMPLACER
MAIL_PASSWORD='A_REMPLACER'
MAIL_FROM_ADDRESS=A_REMPLACER
MAIL_FROM_NAME="JB Hôtel"

# Adresse publique encodée dans le QR code des factures : page web servie par Laravel.
VERIFICATION_BASE_URL=https://api.jb-hotel.com

# En-tête des tickets 80 mm (provisoire, Q-09 / Q-16 : valeurs à fournir par l'hôtel).
HOTEL_NAME="JB Hôtel"
HOTEL_ADDRESS=
HOTEL_CITY="Bangui, République centrafricaine"
HOTEL_PHONE=
HOTEL_EMAIL=
HOTEL_TAX_ID=
HOTEL_RCCM=
