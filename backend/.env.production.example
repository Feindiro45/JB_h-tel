# LWS — modele sans secrets, a copier en .env sur le serveur Laravel.
# Frontend sur banguiweb-tech.com ; racine publique de Laravel dans /backend.
APP_NAME="JB Hôtel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://banguiweb-tech.com/backend
APP_TIMEZONE=Africa/Bangui
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

FRONTEND_URL=https://banguiweb-tech.com
APP_FRONTEND_URL=https://banguiweb-tech.com
SANCTUM_STATEFUL_DOMAINS=banguiweb-tech.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
# LWS Panel : relever Ip serveur, Base et Utilisateur dans MySql & PhpMyadmin.
# Les quatre valeurs DB ci-dessous doivent etre remplacees avant la mise en ligne.
# Sur LWS Panel, DB_HOST est l'IP MySQL fournie par LWS, pas localhost.
DB_HOST=A_REMPLACER_IP_SERVEUR_MYSQL_LWS
DB_PORT=3306
DB_DATABASE=A_REMPLACER_NOM_BASE_LWS
DB_USERNAME=A_REMPLACER_UTILISATEUR_LWS
DB_PASSWORD='A_REMPLACER'

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=jb_hotel_session
SESSION_DOMAIN=null
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Réutiliser le compte SMTP fonctionnel, sans copier son secret dans Git.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.banguiweb-tech.com
MAIL_PORT=465
MAIL_USERNAME=ADRESSE_SMTP_A_REMPLACER
MAIL_PASSWORD='A_REMPLACER'
MAIL_FROM_ADDRESS=ADRESSE_SMTP_A_REMPLACER
MAIL_FROM_NAME="JB Hôtel"

VERIFICATION_BASE_URL=https://banguiweb-tech.com/backend
HOTEL_NAME="JB Hôtel"
HOTEL_ADDRESS=
HOTEL_CITY="Bangui, République centrafricaine"
HOTEL_PHONE=
HOTEL_EMAIL=
HOTEL_TAX_ID=
HOTEL_RCCM=
