APP_NAME="JB Hôtel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Bangui
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jb_hotel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# E-mails aux clients (D-039). En local : MAIL_MAILER=log (messages écrits dans storage/logs).
# En production : SMTP de l'hôtel (Q-22) et une file d'attente active (php artisan queue:work).
MAIL_FROM_ADDRESS="no-reply@jbhotel.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Comptes de démonstration (local uniquement). Vide = mot de passe aléatoire affiché au seed.
DEMO_USERS_PASSWORD=

# Adresse publique encodée dans le QR code des factures (vérification par tout public).
VERIFICATION_BASE_URL=http://localhost:8000
# En-tête des factures (provisoire, Q-09 / Q-16).
HOTEL_NAME="JB Hôtel"
HOTEL_ADDRESS=
HOTEL_PHONE=
HOTEL_EMAIL=
HOTEL_TAX_ID=
HOTEL_RCCM=
