APP_NAME="JB Hôtel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Bangui
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jb_hotel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mails aux clients (D-039) et au personnel : alerte de connexion, invitation (D-054).
# Sans serveur d'envoi : MAIL_MAILER=log (messages écrits dans storage/logs, rien ne part).
# Envoi réel par le SMTP de l'hébergeur de l'hôtel (exemple, valeurs à remplacer) :
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtps          # smtps pour le port 465 ; smtp pour le port 587 (STARTTLS)
#   MAIL_HOST=mail.domaine-de-l-hotel.cf
#   MAIL_PORT=465
#   MAIL_USERNAME=compte@domaine-de-l-hotel.cf
#   MAIL_PASSWORD='...'         # entre apostrophes s'il contient $, ! ou @ ; jamais dans Git
#   MAIL_FROM_ADDRESS="reception@domaine-de-l-hotel.cf"   # adresse autorisée par ce compte
# Vérification : php artisan jb:mail-test adresse@exemple.cf (ou Paramètres > Envoyer un e-mail de test).
# Les e-mails partent en file d'attente : laisser tourner « php artisan queue:work ».
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@jbhotel.local"
MAIL_FROM_NAME="${APP_NAME}"
# Adresse de l'application dans les e-mails (lien de l'invitation) : par défaut la 1re de FRONTEND_URL.
# APP_FRONTEND_URL=https://gestion.domaine-de-l-hotel.cf
# Validité du lien de l'invitation, en minutes (72 h par défaut).
# AUTH_INVITATION_EXPIRE_MINUTES=4320

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Comptes de démonstration (local uniquement). Vide = mot de passe aléatoire affiché au seed.
DEMO_USERS_PASSWORD=

# Adresse publique encodée dans le QR code des factures (vérification par tout public).
VERIFICATION_BASE_URL=http://localhost:8000
# En-tête des factures (provisoire, Q-09 / Q-16).
HOTEL_NAME="JB Hôtel"
HOTEL_ADDRESS=
HOTEL_PHONE=
HOTEL_EMAIL=
HOTEL_TAX_ID=
HOTEL_RCCM=
